__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local runtime state
backend/storage/
storage/
*.db
*.sqlite3
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Credentials and key material. Never commit any of these.
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
credentials.json
service-account*.json
secrets.*
*.secret
id_rsa*
.netrc
.npmrc
.pypirc

# Model weights and large local artifacts. Anchored to the repository root:
# a bare "models/" also matched backend/app/db/models/, which silently kept
# source files out of the repository.
*.gguf
*.safetensors
*.bin
/models/
/ollama/

# Uploaded documents and generated artifacts (may contain confidential data)
artifacts/
uploads/
data/
