# Relational database. SQLite by default so the API runs with no external services.
# Docker Compose overrides this with the Postgres URL below.
DATABASE_URL=sqlite:///./sih.db
# DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sih

# JWT signing. Generate a real value for anything other than local development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes. Startup refuses a short or placeholder key unless DEBUG=true.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Raw upload storage. MinIO replaces this later behind the same StorageInterface.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=100

# Postgres credentials, read by docker-compose. No default: compose fails
# rather than starting a database with a password committed to the repo.
POSTGRES_USER=sih
POSTGRES_PASSWORD=
POSTGRES_DB=sih

# Sovereignty: the API must never reach the public internet.
ALLOW_EXTERNAL_NETWORK=false

# Interactive API docs (/docs, /redoc, /openapi.json) publish the whole API
# surface. Fine locally; leave unset on anything shared or deployed.
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Model layer (Part 02) ---
# Both runtimes must be loopback or a compose service name. The provider
# adapters refuse anything else: prompts must never leave this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Left empty until the lab GPU is available.
VLLM_BASE_URL=
# Startup asks the runtime which models it holds. Set false for an offline boot.
REFRESH_MODEL_REGISTRY_ON_STARTUP=true

# --- Demo convenience ---
# Seeds one account (admin@mrpl.local / workbench) on an empty database.
# Turn off for any deployment that is not the demo.
SEED_DEMO_USER=true
SEED_ADMIN_EMAIL=admin@mrpl.local
# This default is published in the repository README, so the app refuses
# to seed the account with it unless DEBUG=true. Change it for anything
# other than local development.
SEED_ADMIN_PASSWORD=workbench

# --- Document intelligence (Part 03) ---
# Tesseract OCR. Leave empty to use PATH; set the full path if the installer
# did not add it (the Windows installer often does not).
TESSERACT_CMD=

# Neo4j holds chunks, embeddings and the P&ID graph. Loopback only.
# NEO4J_PASSWORD has no default and must be set: docker-compose refuses to
# start without it, and the client refuses to connect to an unauthenticated
# graph that would be holding confidential document text.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
